{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "templates/**",
        "static/**",
        "vendor/threeui/public/landing-pages/**"
      ]
    },
    "app.py": {
      "includeFiles": [
        "templates/**",
        "static/**",
        "vendor/threeui/public/landing-pages/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
